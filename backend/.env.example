# Server
PORT=4000
NODE_ENV=development

# Frontend origin allowed to call this API (comma-separate for multiple)
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL connection string used by Prisma)
DATABASE_URL="postgresql://chatgpt_clone:chatgpt_clone@localhost:5432/chatgpt_clone?schema=public"

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=cc_token

# AI provider (any OpenAI-compatible Chat Completions API)
AI_API_KEY=sk-your-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TITLE_MODEL=gpt-4o-mini

# Context management
AI_MAX_HISTORY_MESSAGES=20
AI_MAX_CONTEXT_CHARS=24000
AI_SYSTEM_PROMPT="You are a helpful, concise AI assistant."

# Message limits
MAX_MESSAGE_LENGTH=8000
